{
  "info": {
    "name": "ODB API",
    "_postman_id": "odb-api-collection",
    "description": "Colección completa de rutas para el proyecto ODB - Sistema de gestión de jugadores, equipos, categorías, orientadores e infracciones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3002",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "12345",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "id_torneo",
      "value": "T00001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - credenciales válidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token para que el resto de la colección lo use automáticamente.",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            },
            "description": "No requiere x-api-key. Retorna { success: true, token, user: { username, rol } } con credenciales válidas.\n\nEJECUTAR ESTE REQUEST PRIMERO: guarda el token en la variable {{token}}, que la colección envía como Bearer en todos los demás endpoints. El token expira en 8 horas.\n\nUsuarios disponibles:\n- admin / admin123 (rol: admin)\n- secretario / secr2025 (rol: secretario)\n- consulta / consulta123 (rol: viewer)"
          }
        },
        {
          "name": "Login - credenciales inválidas",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrongpassword\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            },
            "description": "Debe retornar 401 con { success: false, message: 'Credenciales inválidas.' }"
          }
        },
        {
          "name": "Login - campos faltantes",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            },
            "description": "Debe retornar 400 cuando falta username o password."
          }
        }
      ]
    },
